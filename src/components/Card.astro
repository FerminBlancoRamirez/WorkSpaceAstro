---
interface Props {
  imagen: string;
  titulo: string;
  texto: string;
}

const { imagen, titulo, texto } = Astro.props;
---

<div class="max-w-sm p-5 bg-white rounded-2xl border border-gray-200 shadow-sm transition-all duration-300 hover:shadow-md hover:border-gray-300">
  <!-- Imagen y Título en línea -->
  <div class="flex items-center gap-4">
    <img 
      src={imagen} 
      alt={titulo}
      loading="lazy"
      class="w-20 h-20 rounded-xl object-cover shrink-0 border border-gray-100 shadow-inner" 
    />
    <h3 class="text-xl font-bold text-gray-900 leading-snug">
      {titulo}
    </h3>
  </div>

  <!-- Texto debajo -->
  <p class="mt-4 text-sm text-gray-600 leading-relaxed">
    {texto}
  </p>
</div>