---
interface Props {
  nombre: string
  imagen: string
}

const { imagen, nombre } = Astro.props;
---

<div class="flex items-center gap-4 max-w-sm p-4 bg-white rounded-xl border border-gray-200 shadow-sm transition-all duration-300 hover:shadow-md hover:border-gray-300">
  <img 
    src={imagen} 
    alt={nombre} 
    loading="lazy" 
    class="w-20 h-20 rounded-full object-cover shrink-0 border border-gray-100" 
  />
  <h2 class="text-xl font-semibold text-gray-800 leading-snug">
    {nombre}
  </h2>
</div>