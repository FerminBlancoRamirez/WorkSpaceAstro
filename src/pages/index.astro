			<Button title="Pulsame">Pulsame</Button>

			<Card
				imagen="https://s1.abcstatics.com/abc/www/multimedia/deportes/2024/11/14/jon-jones-ufc-RmXwQQ7YnqdsozUI78xeLUJ-1200x840@diario_abc.jpg"
