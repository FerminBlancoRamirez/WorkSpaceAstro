---
// se ejecuta en el servidor
const nombre = "Fermin";
const luchadoresUFC = [
	"Alexander Volkanovsky",
	"Khamzat Chimaev",
	"Jon Jones",
	"Alexandre Pantoja",
	"Kevin Vallejos",
];
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<!-- Se ejecuta en el cliente -->
<script>
	const valor = 5;
</script>

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Document</title>
	</head>
	<body>
		<BaseLayout>
			<h1>Mi primera pagina en astro</h1>
			<p>Yo me llamo {nombre}</p>
			<h2>Luchadores UFC top pero random</h2>
			<ul>
				{luchadoresUFC.map((luchador) => <li>{luchador}</li>)}
