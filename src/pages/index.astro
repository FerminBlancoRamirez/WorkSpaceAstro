---
import Card from "../components/Card.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Se ejecuta en el servidor
const nombre = "Fermin";
const luchadoresUFC = [
  "Alexander Volkanovski",
  "Khamzat Chimaev",
  "Jon Jones",
  "Alexandre Pantoja",
  "Kevin Vallejos",
];
---

<BaseLayout>
  <script>
    const valor = 5;
  </script>

  <main class="max-w-4xl mx-auto px-4 py-10 sm:px-6 lg:px-8 space-y-10">
    
    <!-- Hero / Encabezado -->
    <header class="text-center space-y-3">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 tracking-tight">
        Mi primera página en <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-red-600">Astro</span>
      </h1>
      <p class="text-lg text-gray-600 font-medium">
        Creado por <span class="text-indigo-600 font-semibold">{nombre}</span>
      </p>
    </header>

    <!-- Lista de luchadores estilo Badges / Grid -->
    <section class="bg-white p-6 sm:p-8 rounded-2xl border border-gray-200 shadow-sm space-y-4">
      <h2 class="text-xl font-bold text-gray-900 border-b border-gray-100 pb-3">
        Luchadores UFC top (pero random)
      </h2>

      <ul class="flex flex-wrap gap-2.5 pt-2">
        {luchadoresUFC.map((luchador) => (
          <li class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-sm font-medium bg-gray-100 text-gray-800 border border-gray-200 hover:bg-red-50 hover:text-red-700 hover:border-red-200 transition-colors">
            <span class="w-2 h-2 rounded-full bg-red-500"></span>
            {luchador}
          </li>
        ))}
      </ul>
    </section>

    <!-- Sección Destacada / Tarjeta -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-gray-900">
        Destacado
      </h2>
      <Card 
        imagen="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSlpILPAgyLslwF8VCcmMe14kQVGPSDNJz6e1ji-gVt8lJcx-Y3czkqa2w&s=10" 
        titulo="El mejor de la historia" 
        texto="Doble campeón, media vida peleando en la mejor división del mundo y sin una derrota"
      />
    </section>

  </main>
</BaseLayout>